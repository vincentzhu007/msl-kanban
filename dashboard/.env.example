DASHBOARD_PUBLIC_URL=https://dashboard.example.com
GITCODE_CLIENT_ID=replace-with-oauth-client-id
# Select the minimum profile-read permission in the GitCode application.
# Set the exact scope supported by your registered app; blank omits scope.
GITCODE_SCOPE=
